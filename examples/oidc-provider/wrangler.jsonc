{
  "name": "telegram-qr-idp",
  "main": "worker.js",
  "compatibility_date": "2026-07-02",

  // Secrets (wrangler secret put), never here:
  //   OIDC_SIGNING_KEY        the private JWK — treat it as you would a TLS private key
  //   TELEGRAM_BOT_TOKEN
  //   TELEGRAM_WEBHOOK_SECRET
  //   PAIRWISE_SALT
  //   PARTNER_CRM_SECRET
  //
  // ISSUER must match exactly what relying parties configure, and must have no trailing slash.
  "vars": {
    "ISSUER": "https://auth.example.com",
    "TELEGRAM_BOT_USERNAME": "your_bot",
    "CHAT_ID": "-1001234567890"
  },

  "kv_namespaces": [
    // In-flight QR sign-ins.
    { "binding": "LOGINS", "id": "<from `wrangler kv namespace create LOGINS`>" }
  ],

  "d1_databases": [
    // Authorization requests, codes, refresh tokens, consent grants. D1 rather than KV: code
    // redemption and refresh rotation are single conditional statements here, where KV can only
    // read-then-write. Apply migrations/oidc-d1.sql once.
    { "binding": "OIDC_DB", "database_name": "oidc", "database_id": "<from `wrangler d1 create oidc`>" }
  ],

  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
